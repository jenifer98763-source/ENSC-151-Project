#include <Wire.h>
#include <Servo.h>
#include "rgb_lcd.h"
rgb_lcd lcd;
Servo groveServo;

const int pinTemp = A0; // Temperature sensor in A0
const int pinDial = A1; // Rotary angle sensor in A1
const int pinLight = A2; //Light sensor in A2
const int pinSound = A3; //Sound sensor in A3

const int pinServo = 2; //Servo in D2
const int pinButton = 3; //Button in D3
const int pinTouch = 4; //Touch Sensor in D4
const int pinBuzzer = 8;  // Buzzer pin in D8

int puzzleCount = 0;
int difficulty = 0;         // 0 = Easy, 1 = Medium, 2 = Hard
String names[] = {"Easy", "Medium", "Hard"};

void setDifficultyColor() {
  if (difficulty == 0) {
    lcd.setRGB(0, 255, 0);
  } else if (difficulty == 1) {
      lcd.setRGB(255, 90, 0);
    } else {
      lcd.setRGB(255, 0, 0);
    }
}

void showDifficulty() {
  setDifficultyColor();
  lcd.clear();
  lcd.setCursor(0, 0);
  lcd.print("Mode: " + names[difficulty]);
  lcd.setCursor(0, 1);
  lcd.print("Tap:next Hold:OK");
}

void chooseDifficulty() {
  showDifficulty();
  while (true) {
    if (digitalRead(pinButton) == HIGH) {
      unsigned long start = millis();
      while (digitalRead(pinButton) == HIGH) {}   // wait for release

      if (millis() - start >= 1000) {
        return;                                    // held: confirm
      }
      difficulty = (difficulty + 1) % 3;           // tapped: next option
      showDifficulty();
      delay(50);                                   
    }
  }
}

void setup() {
  pinMode(pinButton, INPUT);
  lcd.begin(16, 2);
  lcd.setRGB(0, 150, 255);

  lcd.setCursor(3, 0);
  lcd.print("Welcome to");
  lcd.setCursor(2, 1);
  lcd.print("Mini Escape!");
  delay(3000);

  chooseDifficulty();

  lcd.clear();
  lcd.print("Selected:");
  lcd.setCursor(0, 1);
  lcd.print(names[difficulty]);
  delay(1500);
  lcd.clear();
}

void loop() {
  
}
